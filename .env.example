# Hospital No-Show Prediction Environment Configuration

# Server Ports & Host
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501

# Operational API URL (used by Streamlit frontend)
BACKEND_API_URL=http://127.0.0.1:8000

# Prediction Scenario ('booking' or 'pre_appointment')
PREDICTION_SCENARIO=booking

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
